# MediLens AI Backend Configuration Example
# Copy this file to .env and configure local settings

ENVIRONMENT=development
DEBUG=false
APP_NAME="MediLens AI Backend"

# PDF File Upload Controls
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins (Comma-separated or list)
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Optional OCR: Specify path to tesseract binary if installed and not in system PATH
# Windows example: TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# Linux example: TESSERACT_CMD="/usr/bin/tesseract"
TESSERACT_CMD=""

# AI Integration (Phase 3)
# Get a key from Google AI Studio: https://aistudio.google.com/
# Leave blank to run in deterministic-only mode (AI returns ai_unavailable status)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0.2

# History Storage & Persistence (Phase 4)
# Controls local SQLite report history persistence (structured summaries only; no raw PDFs)
ENABLE_HISTORY_PERSISTENCE=true
SQLITE_DB_PATH="medilens_history.db"

# Enable Synthetic Sample Reports
ENABLE_DEMO_MODE=true


